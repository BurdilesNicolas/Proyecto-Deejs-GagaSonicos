// ============================================================
// REGLAS DE FIRESTORE PARA RESEÑAS Y RECOMENDACIONES
// ------------------------------------------------------------
// NO reemplaces tus reglas completas con este archivo: copiá
// las funciones y los bloques "match /resenas" y
// "match /recomendaciones" dentro de las reglas que ya tenés
// (las de "usuarios" tienen que seguir como están).
//
// Dónde pegarlas: Firebase Console > Firestore Database > Reglas.
// ============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿El usuario que hace la consulta es administrador?
    function esAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // En un voto solo se puede agregar o quitar el uid propio de "votantes".
    function soloMiVoto() {
      let antes = resource.data.votantes;
      let despues = request.resource.data.votantes;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votantes'])
        && despues.toSet().difference(antes.toSet()).hasOnly([request.auth.uid])
        && antes.toSet().difference(despues.toSet()).hasOnly([request.auth.uid]);
    }

    // ---------- Reseñas ----------
    match /resenas/{resenaId} {
      // Cualquiera puede leerlas (se ven sin iniciar sesión).
      allow read: if true;

      // Solo con sesión iniciada, a nombre propio y con datos válidos.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['productoId', 'calificacion', 'comentario', 'autorUid', 'autorNombre', 'autorCorreo', 'votantes', 'fecha'])
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.autorCorreo == request.auth.token.email
        && request.resource.data.productoId is int
        && request.resource.data.calificacion is int
        && request.resource.data.calificacion >= 1
        && request.resource.data.calificacion <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() >= 10
        && request.resource.data.comentario.size() <= 500
        && request.resource.data.votantes == []
        && request.resource.data.fecha == request.time;

      // Votar "Útil": cualquier usuario con sesión, solo sobre su propio voto.
      allow update: if request.auth != null && soloMiVoto();

      // Eliminar: el autor o un administrador.
      allow delete: if request.auth != null
        && (resource.data.autorUid == request.auth.uid || esAdmin());
    }

    // ---------- Recomendaciones ----------
    match /recomendaciones/{recomendacionId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['tipo', 'titulo', 'comentario', 'autorUid', 'autorNombre', 'autorCorreo', 'votantes', 'fecha'])
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.autorCorreo == request.auth.token.email
        && request.resource.data.tipo in ['Vinilo', 'Cassette', 'CD', 'Artista', 'Equipo']
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 2
        && request.resource.data.titulo.size() <= 60
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() >= 10
        && request.resource.data.comentario.size() <= 500
        && request.resource.data.votantes == []
        && request.resource.data.fecha == request.time;

      allow update: if request.auth != null && soloMiVoto();

      allow delete: if request.auth != null
        && (resource.data.autorUid == request.auth.uid || esAdmin());
    }
  }
}
